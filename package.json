{
  "name": "@ink-os/deploy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "ink-os-cloud": "cli/cloud.mjs" },
  "scripts": {
    "up": "docker compose up --build -d --wait",
    "down": "docker compose down",
    "status": "docker compose ps",
    "logs": "docker compose logs -f",
    "check": "node scripts/check.mjs",
    "cloud": "node cli/cloud.mjs",
    "check:cloud": "node --test tests/cloud-*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
